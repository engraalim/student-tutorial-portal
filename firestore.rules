rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT:
    // Replace this UID with the Firebase Authentication UID of the tutor/admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "YOUR_ADMIN_FIREBASE_UID";
    }

    function signedIn() {
      return request.auth != null;
    }

    // Student profile document ID MUST equal the student's Firebase Auth UID.
    match /students/{studentUid} {
      allow read: if signedIn() && (request.auth.uid == studentUid || isAdmin());
      allow create, update, delete: if isAdmin();

      match /marks/{markId} {
        allow read: if signedIn() && (request.auth.uid == studentUid || isAdmin());
        allow create, update, delete: if isAdmin();
      }
    }

    // All signed-in students can read course notices.
    // Only the admin can create/change/delete them.
    match /notices/{noticeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
