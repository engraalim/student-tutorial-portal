rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "j2dKbWefhlay5ABzvUsXJDwr8ZX2";
    }

    function hasAuthEmail() {
      return signedIn()
        && request.auth.token.email != null;
    }

    /*
      Accepted examples:
      user@mit.edu
      user@college.ac
      user@uow.edu.au
      user@ru.ac.bd
      user@cam.ac.uk
    */
    function isAcademicEmail(email) {
      return email != null
        && email.matches(
          '^[^@]+@[^@]+[.](edu|ac)([.][A-Za-z]{2})?$'
        );
    }

    function studentExists(studentUid) {
      return exists(
        /databases/$(database)/documents/students/$(studentUid)
      );
    }

    function isApprovedStudent(studentUid) {
      return signedIn()
        && request.auth.uid == studentUid
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && isAcademicEmail(request.auth.token.email)
        && studentExists(studentUid)
        && get(
          /databases/$(database)/documents/students/$(studentUid)
        ).data.status == "approved";
    }


    /* =====================================================
       STUDENT PROFILES
    ====================================================== */

    match /students/{studentUid} {

      /*
        Tutor/admin can read all profiles.
        Student can read only their own profile.
      */
      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == studentUid
        );


      /*
        Self-registration:
        - user must create their OWN UID document
        - Authentication email must be academic
        - profile email must equal Authentication email
        - initial status must be pending
      */
      allow create: if signedIn()
        && request.auth.uid == studentUid
        && hasAuthEmail()
        && isAcademicEmail(request.auth.token.email)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.registrationMethod == "self"
        && request.resource.data.keys().hasOnly([
          "studentId",
          "name",
          "email",
          "course",
          "status",
          "registrationMethod",
          "createdAt",
          "approvedAt"
        ]);


      /*
        Only admin can change status/profile after creation.
      */
      allow update, delete: if isAdmin();


      /* ===================================================
         MARKS
      ==================================================== */

      match /marks/{markId} {

        allow read: if isAdmin()
          || isApprovedStudent(studentUid);

        allow create, update, delete:
          if isAdmin();
      }
    }


    /* =====================================================
       NOTICES
    ====================================================== */

    match /notices/{noticeId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && isAcademicEmail(request.auth.token.email)
          && studentExists(request.auth.uid)
          && get(
            /databases/$(database)/documents/students/$(request.auth.uid)
          ).data.status == "approved"
        );

      allow create, update, delete:
        if isAdmin();
    }


    /* =====================================================
       DEFAULT DENY
    ====================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
